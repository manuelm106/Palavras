rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // Administradores: cuentas con un documento en admins/{uid} (se crea a mano en la consola).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Lista privada de cada usuario (palabras, puntajes y foto).
    match /users/{uid} {
      allow read, write: if isMe(uid);
    }
    // Formato anterior: solo para la migración automática.
    match /users/{uid}/words/{wordId} {
      allow read, write: if isMe(uid);
    }

    // Nombre y foto que ven los demás. Se leen de a uno (no se pueden listar).
    match /profiles/{uid} {
      allow get: if signedIn();
      allow write: if isMe(uid);
    }

    // Correo → uid, para agregar amigos con el correo exacto (no se pueden listar).
    match /emails/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Amistades: un documento por pareja, con id "uidMenor_uidMayor".
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requestedBy', 'status', 'createdAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      // Solo quien recibió la solicitud puede aceptarla.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      // Cualquiera de los dos puede rechazar, cancelar o terminar la amistad.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Lista de administradores: solo se edita desde la consola de Firebase.
    match /admins/{uid} {
      allow get: if isMe(uid);
      allow list, write: if false;
    }

    // Mensajes de ayuda y feedback: cualquiera puede enviar uno (con o sin sesión);
    // solo los administradores los leen, cambian su estado o los borran.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'message', 'email', 'uid', 'name', 'createdAt', 'userAgent', 'appVersion', 'status'])
        && request.resource.data.type in ['sugerencia', 'problema', 'pedido', 'otro']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (request.resource.data.name == null || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt is number
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 400
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.status == 'new';
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'seen', 'resolved'];
    }

    // Palabras y frases compartidas: las ve el autor y los amigos de `audience`.
    match /posts/{postId} {
      allow read: if signedIn()
        && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.audience);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.audience is list
        && request.resource.data.audience.size() <= 500
        && request.resource.data.likes == {}
        && !request.resource.data.keys().hasAny(['commentCount', 'lastCommentAt', 'lastCommentBy']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      // Los amigos solo pueden poner o quitar SU propio like.
      allow update: if signedIn()
        && request.auth.uid in resource.data.audience
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid]);
      // Contador de comentarios: sube o baja de a uno; el último comentario lo firma quien escribe.
      allow update: if signedIn()
        && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.audience)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastCommentAt', 'lastCommentBy'])
        && (request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) + 1
            || request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) - 1)
        && request.resource.data.get('commentCount', 0) >= 0
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastCommentAt', 'lastCommentBy'])
            || request.resource.data.lastCommentBy == request.auth.uid);

      // Comentarios: los ven y escriben el autor y los amigos de `audience`.
      match /comments/{commentId} {
        function parent() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
        function canSee() { return signedIn() && (parent().owner == request.auth.uid || request.auth.uid in parent().audience); }
        allow read: if canSee();
        allow create: if canSee()
          && request.resource.data.keys().hasOnly(['author', 'text', 'createdAt'])
          && request.resource.data.author == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is number;
        // Borra quien escribió el comentario o el autor de la publicación.
        allow delete: if signedIn()
          && (resource.data.author == request.auth.uid || parent().owner == request.auth.uid);
      }
    }
  }
}
